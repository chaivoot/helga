---
// A whole-card link: a short pitch on the left, a pill-shaped action on the right.
interface Props {
  href: string;
  title: string;
  text: string;
  action: string;
  tone?: 'warm' | 'white' | 'dark';
  /** Colour of the action pill. */
  actionTone?: 'primary' | 'dark' | 'cream';
  size?: 'lg' | 'md' | 'sm';
}

const {
  href,
  title,
  text,
  action,
  tone = 'warm',
  actionTone = 'primary',
  size = 'md',
} = Astro.props;
---

<a href={href} class:list={['banner', `banner--${tone}`, `banner--${size}`]}>
  <span class="copy">
    <strong class="head-font">{title}</strong>
    <span class="text">{text}</span>
  </span>
  <span class:list={['action', `action--${actionTone}`]}>{action} →</span>
</a>

<style>
  .banner {
    text-decoration: none;
    color: var(--ink);
    border-radius: 24px;
    padding: 28px 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  strong {
    font-size: 22px;
  }
  .text {
    font-size: 16px;
  }
  .action {
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 999px;
  }

  .banner--lg {
    padding: 32px;
  }
  .banner--lg strong {
    font-size: 24px;
  }
  .banner--sm {
    padding: 26px 28px;
  }
  .banner--sm strong {
    font-size: 20px;
  }
  .banner--sm .text {
    font-size: 15px;
  }
  .banner--sm .action {
    padding: 13px 22px;
  }

  .banner--warm {
    background: var(--sand-warm);
  }
  .banner--warm .text {
    color: var(--warm-ink);
  }
  .banner--white {
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .banner--white .text {
    color: var(--muted);
  }
  .banner--dark {
    background: var(--ink);
    color: #fff;
  }
  .banner--dark .text {
    color: var(--on-dark);
  }

  .action--primary {
    background: var(--brown);
    color: #fff;
  }
  .action--dark {
    background: var(--ink);
    color: #fff;
  }
  .action--cream {
    background: var(--cream);
    color: var(--ink);
  }
</style>
