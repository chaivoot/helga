---
import { site } from '../data/site';
import Icon from './Icon.astro';

const { contact } = site;
---

<footer class="ftr">
  <div class="wrap cols">
    <div class="col brand">
      <span class="brand-name">{site.name}</span>
      <span class="brand-sub">{site.nameTh}<br />[โลโก้ - รอออกแบบ]</span>
    </div>
    <div class="col">
      <strong>ติดต่อ</strong>
      <span>LINE: {contact.line}</span>
      <span>Facebook: {contact.facebook}</span>
      <span>โทร: {contact.phone}</span>
      <span>พื้นที่: {contact.area}</span>
    </div>
    <div class="col">
      <strong>ความรู้</strong>
      <a href="/sheltie/">รู้จักเชลตี้</a>
      <a href="/sheltie/health/">สุขภาพเชลตี้</a>
      <a href="/sheltie/colors/">สีเชลตี้</a>
      <a href="/journal/">บันทึกเฮลก้า</a>
    </div>
    <div class="col">
      <strong>โปรแกรมฝึก</strong>
      <span class="loose">
        ดูแลการฝึกและปูนิสัยโดยครูฝึกจาก<a
          href="https://dogsanook.com"
          class="quiet"
          target="_blank"
          rel="noopener">โรงเรียนหมาสนุก</a
        >
      </span>
    </div>
  </div>
</footer>

<!-- Floating LINE button (mobile only) -->
<a class="fab" href={contact.lineUrl} aria-label="ทัก LINE">
  <Icon name="chat" size={22} />
  ทัก LINE
</a>

<style>
  .ftr {
    background: var(--footer);
    color: #cfc4b8;
  }
  .cols {
    padding-block: 48px 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
  }
  .col strong {
    color: #fff;
    font-weight: 600;
  }
  .col a {
    color: #cfc4b8;
    text-decoration: none;
  }
  .col a:hover {
    color: #fff;
  }
  .loose {
    line-height: 1.7;
  }
  /* A link that reads as plain text. */
  .col a.quiet,
  .col a.quiet:hover {
    color: inherit;
    cursor: text;
  }
  .brand {
    gap: 10px;
  }
  .brand-name {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: 24px;
    color: #fff;
  }
  .brand-sub {
    font-size: 14px;
    line-height: 1.7;
  }

  .fab {
    display: none;
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    align-items: center;
    gap: 8px;
    background: var(--line-green);
    color: var(--line-ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    padding: 14px 20px;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  @media (max-width: 860px) {
    .fab {
      display: flex;
    }
  }
</style>
