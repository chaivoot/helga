---
// Inline stroke icons (24x24 grid). Colour follows `currentColor`.
const icons = {
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  document: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h4"/>',
  home: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/>',
  homeDoor: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
  homeCheck: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M9 15l2 2 4-4"/>',
  homeMoon:
    '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M14.5 13.5a3 3 0 1 1-3-3 2.3 2.3 0 0 0 3 3z"/>',
  person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"/>',
  signup: '<path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h5"/><path d="M15 17l2 2 3-4"/>',
  lineage:
    '<circle cx="12" cy="5" r="2.5"/><circle cx="6" cy="17" r="2.5"/><circle cx="18" cy="17" r="2.5"/><path d="M12 7.5v4M12 11.5l-5 3.5M12 11.5l5 3.5"/>',
  heart: '<path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/>',
  heartPlus:
    '<path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/><path d="M9 12h6M12 9v6"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 8v.01M11 12h1v5h1"/>',
  warning: '<path d="M12 3l9 16H3z"/><path d="M12 10v4M12 17v.01"/>',
  chat: '<path d="M21 11.5c0 4.1-4 7.5-9 7.5-1 0-2-.1-2.9-.4L5 20l1-3.4C4.2 15.2 3 13.5 3 11.5 3 7.4 7 4 12 4s9 3.4 9 7.5z"/>',
  check: '<path d="M5 12l4 4 10-10"/>',
  checkCircle: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  image:
    '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 8"/>',
  paw: '<circle cx="7" cy="9" r="1.8"/><circle cx="11" cy="6" r="1.8"/><circle cx="15" cy="6" r="1.8"/><circle cx="18" cy="10" r="1.8"/><path d="M8 17c0-3 2-5 4-5s4 2 4 5c0 1.5-1 2.5-2.5 2.5-.9 0-1-.5-1.5-.5s-.6.5-1.5.5C9 19.5 8 18.5 8 17z"/>',
  facebook: '<path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h2.5l.5-4h-3V7a1 1 0 0 1 1-1h2z"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  brain:
    '<path d="M12 3a4 4 0 0 0-4 4 3 3 0 0 0-2 5 3 3 0 0 0 2 5 4 4 0 0 0 4 4"/><path d="M12 3a4 4 0 0 1 4 4 3 3 0 0 1 2 5 3 3 0 0 1-2 5 4 4 0 0 1-4 4"/><path d="M12 3v18"/>',
  crate: '<rect x="3" y="6" width="18" height="14" rx="2"/><path d="M7 6v14M11 6v14M15 6v14M19 6v14"/>',
  pad: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 9h16M9 4v16"/>',
  ball: '<circle cx="12" cy="12" r="8"/><path d="M4.5 9.5c3 1 12 1 15 0M4.5 14.5c3-1 12-1 15 0"/>',
  bowl: '<path d="M3 12h18a9 6 0 0 1-18 0z"/><circle cx="9" cy="9" r="1"/><circle cx="12" cy="8" r="1"/><circle cx="15" cy="9" r="1"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M9 12l2 2 4-4"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  /** Stroke width */
  sw?: number;
  color?: string;
  class?: string;
}

const { name, size = 24, sw = 2, color, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style={color ? `color:${color};flex-shrink:0` : 'flex-shrink:0'}
  set:html={icons[name]}
/>
