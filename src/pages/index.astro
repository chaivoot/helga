---
import Icon from '../components/Icon.astro';
import JournalCard from '../components/JournalCard.astro';
import Photo from '../components/Photo.astro';
import ScamWarning from '../components/ScamWarning.astro';
import { getJournalPosts } from '../data/journal';
import { page, paragraphs, photo, rich } from '../data/pages';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../content/pages/home.json';

const p = page(content);
const { contact } = site;

const steps = p.steps.map((step, i) => ({
  title: step.title,
  desc: step.desc || site.firstLitter,
  num: i + 1,
  state: i + 1 === site.currentStep ? 'current' : i + 1 < site.currentStep ? 'done' : 'todo',
}));

// Icons are matched to items by position.
const trustIcons = ['document', 'homeDoor', 'person'] as const;
const promiseIcons = ['lineage', 'heartPlus', 'homeCheck'] as const;

const posts = (await getJournalPosts()).slice(0, 3);
---

<BaseLayout
  current="home"
  description={p.heroLead}
>
  <!-- Hero -->
  <section class="wrap split hero">
    <div class="stack" style="--gap:20px">
      <span class="status">
        <Icon name="clock" size={16} />
        {p.heroBadge}
      </span>
      <h1>{site.name}<br /><span>{site.breed}</span></h1>
      <p class="head-font hero-th">{site.nameTh}</p>
      <p class="hero-lead" set:html={rich(p.heroLead)} />
      <div class="hero-actions">
        <a href="/puppies/" class="btn">ลงชื่อรอครอกแรก <Icon name="arrowRight" size={18} /></a>
        <a href="/puppies/partners/" class="btn btn--outline">ดูลูกเชลตี้จากฟาร์มพันธมิตร</a>
      </div>
    </div>
    <div class="hero-photo">
      <Photo {...photo(p.heroImage)} ratio="4 / 5" radius={28} loading="eager" />
      <div class="hero-tag">
        <span class="head-font">{p.heroTagTitle}</span>
        <span>{p.heroTagSub}</span>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="trust" aria-label="จุดเด่นของเรา">
    <div class="wrap trust-grid">
      {
        p.trust.map((item, i) => (
          <div>
            <Icon name={trustIcons[i] ?? 'checkCircle'} size={26} sw={1.8} />
            <span set:html={rich(item.text)} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Entry cards -->
  <section class="wrap entries">
    <a href="/sheltie/" class="card entry">
      <Photo {...photo(p.entrySheltieImage)} ratio="1 / 1" sizes="(max-width: 700px) 100vw, 300px" />
      <div class="entry-label">
        <span class="head-font">รู้จักเชลตี้</span><span class="arrow" aria-hidden="true">→</span>
      </div>
    </a>
    <a href="/our-dogs/" class="card entry">
      <Photo {...photo(p.entryHelgaImage)} ratio="1 / 1" sizes="(max-width: 700px) 100vw, 300px" />
      <div class="entry-label">
        <span class="head-font">พบกับเฮลก้า</span><span class="arrow" aria-hidden="true">→</span>
      </div>
    </a>
    <a href="/puppies/program/" class="card entry">
      <Photo {...photo(p.entryProgramImage)} ratio="1 / 1" sizes="(max-width: 700px) 100vw, 300px" />
      <div class="entry-label">
        <span class="head-font">โปรแกรมเตรียมความพร้อม</span><span class="arrow" aria-hidden="true"
          >→</span
        >
      </div>
    </a>
    <a href="/puppies/" class="entry entry--cta">
      <Icon name="signup" size={40} sw={1.6} />
      <div class="stack" style="--gap:6px">
        <span class="head-font">{p.entryCtaTitle}</span>
        <span class="entry-sub">{p.entryCtaText}</span>
      </div>
    </a>
  </section>

  <!-- About -->
  <section class="wrap split about">
    <div class="about-photos">
      <Photo {...photo(p.aboutImage1)} ratio="1 / 1" radius={20} />
      <Photo {...photo(p.aboutImage2)} ratio="1 / 1" radius={20} style="margin-top:36px" />
    </div>
    <div class="stack" style="--gap:18px">
      <span class="eyebrow">เกี่ยวกับเรา</span>
      <h2 class="home-title">{p.aboutTitle}</h2>
      {paragraphs(p.aboutBody).map((text) => <p class="body-text" set:html={rich(text)} />)}
    </div>
  </section>

  <!-- Promises -->
  <section class="band-sand">
    <div class="wrap stack block" style="--gap:36px">
      <div class="stack center" style="--gap:10px">
        <span class="eyebrow">คำมั่นสัญญาของเรา</span>
        <h2 class="home-title">{p.promisesTitle}</h2>
      </div>
      <div class="grid-260">
        {
          p.promises.map((promise, i) => (
            <article class="promise">
              <div class="promise-icon">
                <Icon name={promiseIcons[i] ?? 'checkCircle'} size={26} sw={1.8} />
              </div>
              <h3>{promise.title}</h3>
              <p set:html={rich(promise.text)} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="wrap stack block" style="--gap:36px">
    <div class="stack" style="--gap:10px">
      <span class="eyebrow">เส้นทางของเฮลก้า</span>
      <h2 class="home-title">{p.timelineTitle}</h2>
    </div>
    <ol class="steps">
      {
        steps.map((step) => (
          <li class:list={['card', 'step', `step--${step.state}`]}>
            <div class="step-top">
              <span class="step-num head-font">{step.num}</span>
              {step.state === 'current' && <span class="step-now">ตอนนี้</span>}
              {step.state === 'done' && <span class="step-done">ผ่านแล้ว</span>}
            </div>
            <h3>{step.title}</h3>
            <p set:html={rich(step.desc)} />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Photo grid -->
  <section class="wrap photo-grid" aria-label="ภาพเฮลก้า">
    {
      p.helgaPhotos.map((item) => (
        <Photo
          {...photo(item.image)}
          ratio="1 / 1"
          radius={18}
          widths={[480]}
          sizes="(max-width: 700px) 50vw, 200px"
        />
      ))
    }
  </section>

  <!-- Journal -->
  <section class="band-white">
    <div class="wrap stack block" style="--gap:32px">
      <div class="journal-head">
        <div class="stack" style="--gap:10px">
          <span class="eyebrow">บันทึกเฮลก้า</span>
          <h2 class="home-title">{p.journalTitle}</h2>
        </div>
        <a href="/journal/" class="text-link">ดูบันทึกทั้งหมด →</a>
      </div>
      <div class="grid-260" style="gap:24px">
        {posts.map((post) => <JournalCard post={post} heading="h3" radius={18} />)}
      </div>
    </div>
  </section>

  <!-- Knowledge -->
  <section class="wrap stack block" style="--gap:32px">
    <div class="stack" style="--gap:10px">
      <span class="eyebrow">ความรู้เรื่องเชลตี้</span>
      <h2 class="home-title">{p.knowledgeTitle}</h2>
    </div>
    <div class="grid-260">
      <a href="/sheltie/" class="card topic">
        <Icon name="info" size={30} sw={1.8} color="var(--slate)" />
        <h3>รู้จักเชลตี้</h3>
        <p>ต้นกำเนิด นิสัย ขนาด และเหมาะกับใคร</p>
      </a>
      <a href="/sheltie/health/" class="card topic">
        <Icon name="heart" size={30} sw={1.8} color="var(--slate)" />
        <h3>สุขภาพเชลตี้</h3>
        <p>โรคทางพันธุกรรมที่ควรรู้ เช่น MDR1, CEA, PRA</p>
      </a>
      <a href="/sheltie/colors/" class="card topic">
        <div class="swatches" aria-hidden="true">
          <span style="background:#B9874D"></span>
          <span style="background:linear-gradient(90deg,#1F1F1F 60%,#A86A2E 60%)"></span>
          <span style="background:#1F1F1F;box-shadow:inset -5px 0 0 #FFFFFF"></span>
        </div>
        <h3>สีเชลตี้</h3>
        <p>เซเบิล ไตรคัลเลอร์ ไบแบล็ก และสีอื่นๆ</p>
      </a>
    </div>
  </section>

  <!-- Reviews: hidden until there are real ones (site.showReviews) -->
  {
    site.showReviews && (
      <section class="wrap stack reviews" style="--gap:24px">
        <h2>จากครอบครัวที่รับน้องไป</h2>
        <div class="grid-260">
          <figure class="card review">
            <blockquote>[ข้อความรีวิวจริงจากลูกค้า]</blockquote>
            <figcaption>[ชื่อครอบครัว / ชื่อน้อง]</figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <!-- Scam warning -->
  <section class="wrap scam">
    <ScamWarning>
      เราติดต่อผ่านช่องทางในเว็บนี้เท่านั้น LINE: {contact.line} / Facebook: {contact.facebook} / โทร:
      {contact.phone} และรับเงินผ่านบัญชีชื่อ {contact.bankAccountName} เท่านั้น หากไม่แน่ใจ ทักถามเราก่อนโอนทุกครั้ง
    </ScamWarning>
  </section>

  <!-- CTA band -->
  <section class="cta">
    <div class="wrap split block" style="gap:32px">
      <div class="stack" style="--gap:14px">
        <h2 class="home-title">{p.ctaTitle}</h2>
        <p set:html={rich(p.ctaText)} />
      </div>
      <div class="cta-actions">
        <a href="/puppies/" class="btn btn--cream">ลงชื่อรอครอกแรก</a>
        <a href={contact.lineUrl} class="btn btn--line">ทัก LINE: {contact.line}</a>
        <a href={contact.phoneUrl} class="btn btn--ghost">โทร {contact.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .block {
    padding-block: 72px;
  }
  .center {
    align-items: center;
    text-align: center;
  }
  .home-title {
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.25;
  }
  .grid-260 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  /* Hero */
  .hero {
    padding-block: 56px 40px;
    gap: 48px;
  }
  .status {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--sand-warm);
    color: var(--amber-ink);
    font-size: 14px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  h1 span {
    color: var(--brown);
  }
  .hero-th {
    font-size: 22px;
    font-weight: 500;
    color: var(--muted);
  }
  .hero-lead {
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 520px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .hero-photo {
    position: relative;
  }
  .hero-tag {
    position: absolute;
    left: -12px;
    bottom: 28px;
    background: var(--surface);
    border-radius: 18px;
    padding: 14px 18px;
    box-shadow: 0 10px 30px rgba(38, 30, 24, 0.12);
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    color: var(--muted);
  }
  .hero-tag .head-font {
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
  }

  /* Trust strip */
  .trust {
    background: var(--brown);
    color: #fff;
  }
  .trust-grid {
    padding-block: 22px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .trust-grid div {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    line-height: 1.5;
  }
  .trust-grid :global(svg) {
    color: var(--cream);
  }

  /* Entry cards */
  .entries {
    padding-block: 56px 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .entry {
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .entry-label {
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .entry-label .head-font {
    font-weight: 600;
    font-size: 18px;
  }
  .arrow {
    color: var(--amber);
    font-size: 20px;
  }
  .entry--cta {
    color: #fff;
    background: var(--amber);
    border-radius: 22px;
    justify-content: space-between;
    padding: 24px;
    min-height: 268px;
  }
  .entry--cta .head-font {
    font-weight: 600;
    font-size: 22px;
  }
  .entry-sub {
    font-size: 14px;
    line-height: 1.6;
    color: #fbebd6;
  }

  /* About */
  .about {
    padding-block: 56px;
    gap: 48px;
  }
  .about-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  /* Promises */
  .promise {
    background: var(--surface);
    border-radius: 22px;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .promise-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--sand-warm);
    color: var(--amber);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .promise h3 {
    font-size: 22px;
  }
  .promise p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  /* Timeline */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
  }
  .step--current {
    border: 2px solid var(--amber);
    box-shadow: 0 10px 30px rgba(160, 98, 31, 0.12);
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .step-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 17px;
    background: var(--sand);
    color: var(--brown);
  }
  .step--current .step-num {
    background: var(--amber);
    color: #fff;
  }
  .step--done .step-num {
    background: var(--brown);
    color: #fff;
  }
  .step-now {
    background: var(--amber);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .step-done {
    color: var(--brown);
    font-size: 13px;
    font-weight: 600;
  }
  .step h3 {
    font-size: 20px;
  }
  .step p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* Photo grid */
  .photo-grid {
    padding-bottom: 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
  }

  /* Journal */
  .journal-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  /* Knowledge */
  .topic {
    text-decoration: none;
    color: var(--ink);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .topic h3 {
    font-size: 20px;
  }
  .topic p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
  }
  .swatches {
    display: flex;
    gap: 4px;
  }
  .swatches span {
    width: 18px;
    height: 18px;
    border-radius: 50%;
  }

  /* Reviews */
  .reviews {
    padding-bottom: 72px;
  }
  .reviews h2 {
    font-size: 32px;
  }
  .review {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .review blockquote {
    font-size: 16px;
    line-height: 1.75;
  }
  .review figcaption {
    font-size: 14px;
    color: var(--muted);
  }

  .scam {
    padding-bottom: 56px;
  }

  /* CTA band */
  .cta {
    background: var(--ink);
    color: #fff;
  }
  .cta p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--on-dark);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
