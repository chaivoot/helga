---
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import content from '../../content/pages/program.json';
import { page, photo, rich } from '../../data/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';

const p = page(content);

// Icons are matched to lessons by position.
const icons = ['brain', 'crate', 'homeMoon', 'pad', 'ball', 'bowl', 'clipboard'] as const;
---

<BaseLayout
  title={p.title}
  current="puppies"
  description={p.lead}
>
  <!-- Hero -->
  <section class="band-sand">
    <div class="wrap split hero">
      <div class="stack">
        <nav class="breadcrumb" aria-label="breadcrumb">
          <a href="/">หน้าแรก</a> / <a href="/puppies/">ลูกสุนัข</a> / โปรแกรมเตรียมความพร้อม
        </nav>
        <h1>{p.title}</h1>
        <p class="lead" set:html={rich(p.lead)} />
      </div>
      <Photo
        {...photo(p.heroImage)}
        illustration
        ratio="4 / 3"
        radius={28}
        loading="eager"
      />
    </div>
  </section>

  <!-- 7 lessons -->
  <section class="wrap stack lessons" style="--gap:28px">
    <h2 class="section-title">{p.lessonsTitle}</h2>
    <div class="lesson-grid">
      {
        p.lessons.map((lesson, i) => (
          <article class="card lesson">
            <div class="lesson-top">
              <div class="lesson-icon">
                <Icon name={icons[i] ?? 'checkCircle'} size={28} sw={1.7} />
              </div>
              <span class="lesson-num head-font">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{lesson.title}</h3>
            <p set:html={rich(lesson.text)} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap cta">
    <CtaBanner
      href="/puppies/"
      title={p.bannerTitle}
      text={p.bannerText}
      action="ลงชื่อรอครอกแรก"
      tone="dark"
      actionTone="cream"
      size="lg"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 48px;
  }
  h1 {
    font-size: clamp(32px, 4.4vw, 50px);
    line-height: 1.2;
  }
  .lessons {
    padding-block: 64px;
  }
  .lesson-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .lesson {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lesson-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .lesson-icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--sand);
    color: var(--brown);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lesson-num {
    font-size: 15px;
    font-weight: 600;
    color: var(--amber-ink);
  }
  .lesson h3 {
    font-size: 20px;
    line-height: 1.35;
  }
  .lesson p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .cta {
    padding-bottom: 72px;
  }
</style>
