---
import CtaBanner from '../../components/CtaBanner.astro';
import FilterChips from '../../components/FilterChips.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { getCollection } from 'astro:content';
import { puppyStatuses, statusLabels } from '../../data/options';
import content from '../../content/pages/partners.json';
import { page, rich } from '../../data/pages';
import { site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const p = page(content);

const filters = [
  { value: 'all', label: 'ทั้งหมด' },
  ...puppyStatuses.map((value) => ({ value, label: statusLabels[value] })),
];

// Available puppies first, then reserved, then delivered.
const partnerPuppies = (await getCollection('puppies'))
  .map((entry) => entry.data)
  .sort((a, b) => puppyStatuses.indexOf(a.status) - puppyStatuses.indexOf(b.status));
const hasPuppies = partnerPuppies.length > 0;
---

<BaseLayout
  title="ลูกเชลตี้จากฟาร์มพันธมิตร"
  current="puppies"
  description={p.lead}
>
  <!-- Page hero -->
  <section class="wrap stack hero" style="--gap:18px">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">หน้าแรก</a> / <a href="/puppies/">ลูกสุนัข</a> / ฟาร์มพันธมิตร
    </nav>
    <h1 class="page-title">{p.title}</h1>
    <p class="lead" style="max-width:760px" set:html={rich(p.lead)} />
    <div class="note-info" role="note" style="align-self:flex-start">
      <Icon name="info" size={20} />
      <span set:html={rich(p.note)} />
    </div>
  </section>

  <!-- Standards -->
  <section class="wrap standards">
    <div class="standards-box stack" style="--gap:18px">
      <h2>{p.standardsTitle}</h2>
      <ul class="standards-list">
        {
          p.standards.map((standard) => (
            <li>
              <Icon name="check" size={22} color="var(--brown)" />
              <span set:html={rich(standard.text)} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Listing -->
  <section class="wrap stack listing" style="--gap:24px">
    <div class="listing-head">
      <h2>{p.listTitle}</h2>
      <FilterChips group="puppies" label="กรองตามสถานะ" options={filters} />
    </div>

    <div class="pups" data-filter-list="puppies" hidden={!hasPuppies}>
      {
        partnerPuppies.map((pup) => (
          <article class="card pup" data-filter-value={pup.status}>
            <Photo
              src={pup.photo}
              alt="ภาพลูกสุนัข"
              temp={pup.tempPhoto}
              ratio="1 / 1"
              sizes="(max-width: 700px) 100vw, 400px"
            >
              <span class:list={['pup-status', `pup-status--${pup.status}`]}>
                {statusLabels[pup.status]}
              </span>
              <span class="pup-media">
                <Icon name="image" size={14} />
                รูป + วิดีโอ
              </span>
            </Photo>
            <div class="pup-body">
              <div class="pup-farm">
                <Icon name="home" size={16} />
                จากฟาร์ม: {pup.farm}
              </div>
              <dl class="pup-facts">
                <dt>เพศ</dt>
                <dd>{pup.sex}</dd>
                <dt>สี</dt>
                <dd>{pup.color}</dd>
                <dt>วันเกิด</dt>
                <dd>{pup.born}</dd>
                <dt>พ่อ / แม่</dt>
                <dd>
                  {pup.sire} / {pup.dam}
                </dd>
                <dt>ราคา</dt>
                <dd class="pup-price">
                  {site.partnerPriceMode === 'show' ? pup.price : 'ทักถามราคา'}
                </dd>
              </dl>
              {pup.status === 'available' ? (
                <a href={site.contact.lineUrl} class="pup-action pup-action--ask">
                  สอบถามตัวนี้ทาง LINE
                </a>
              ) : (
                <span class="pup-action">{statusLabels[pup.status]}</span>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="empty" data-filter-empty="puppies" hidden={hasPuppies}>
      <Icon name="paw" size={48} sw={1.6} color="var(--slate)" />
      <strong class="head-font">{p.emptyTitle}</strong>
      <p>{p.emptyText}</p>
      <a href={site.contact.lineUrl} class="btn btn--line empty-action">ฝากชื่อทาง LINE</a>
    </div>
  </section>

  <!-- Back to waitlist -->
  <section class="wrap back">
    <CtaBanner
      href="/puppies/"
      title={p.bannerTitle}
      text={p.bannerText}
      action="ลงชื่อรอครอกแรก"
      tone="white"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 56px 32px;
  }

  .standards {
    padding-block: 16px 48px;
  }
  .standards-box {
    background: var(--sand);
    border-radius: 24px;
    padding: 28px;
  }
  .standards-box h2 {
    font-size: 24px;
  }
  .standards-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px 24px;
    font-size: 16px;
    line-height: 1.6;
  }
  .standards-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .standards-list :global(svg) {
    margin-top: 2px;
  }

  .listing {
    padding-bottom: 72px;
  }
  .listing-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .listing-head h2 {
    font-size: 28px;
  }
  .pups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .pup {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .pup-status {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 13px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .pup-status--available {
    background: var(--brown);
    color: #fff;
  }
  .pup-status--reserved {
    background: var(--sand-warm);
    color: #6e3f0c;
  }
  .pup-status--delivered {
    background: var(--surface);
    color: var(--muted);
  }
  .pup-media {
    position: absolute;
    right: 12px;
    bottom: 12px;
    background: rgba(38, 30, 24, 0.78);
    color: #fff;
    font-size: 13px;
    padding: 5px 10px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pup-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-grow: 1;
  }
  .pup-farm {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--slate-bg);
    color: var(--slate-ink);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 600;
  }
  .pup-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    font-size: 15px;
  }
  .pup-facts dt {
    color: var(--muted);
  }
  .pup-price {
    font-weight: 600;
  }
  .pup-action {
    margin-top: auto;
    text-align: center;
    background: var(--sand-mute);
    color: var(--muted);
    font-weight: 600;
    font-size: 15px;
    padding: 14px;
    border-radius: 999px;
  }
  .pup-action--ask {
    background: var(--line-green);
    color: var(--line-ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
  }

  .empty {
    background: var(--surface);
    border: 1.5px dashed var(--line-strong);
    border-radius: 24px;
    padding: 56px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .empty strong {
    font-size: 22px;
  }
  .empty p {
    font-size: 16px;
    color: var(--muted);
  }
  .empty-action {
    font-weight: 700;
    font-size: 16px;
    padding: 14px 26px;
  }

  .back {
    padding-bottom: 72px;
  }
</style>
