---
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import content from '../../content/pages/puppies.json';
import { page, photo, rich } from '../../data/pages';
import { site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const p = page(content);

---

<BaseLayout
  title="ลูกสุนัข ลงชื่อรอครอกแรก"
  current="puppies"
  description={p.lead}
>
  <!-- Page hero -->
  <section class="band-sand">
    <div class="wrap split hero">
      <div class="stack" style="--gap:18px">
        <nav class="breadcrumb" aria-label="breadcrumb"><a href="/">หน้าแรก</a> / ลูกสุนัข</nav>
        <h1 class="page-title">{p.title}</h1>
        <p class="lead" style="max-width:560px" set:html={rich(p.lead)} />
        <a href="#waitlist" class="btn" style="align-self:flex-start">ลงชื่อรอครอกแรก</a>
      </div>
      <div class="status stack">
        <span class="eyebrow">สถานะตอนนี้</span>
        <div class="status-who">
          <Photo
            class="status-photo"
            {...photo(p.statusImage)}
            compact
            widths={[200]}
            sizes="72px"
          />
          <div class="stack" style="--gap:4px">
            <strong class="head-font">{p.statusTitle}</strong>
            <span>{p.statusText}</span>
          </div>
        </div>
        <dl class="status-facts">
          <div><dt>พ่อพันธุ์</dt><dd>{p.sireStatus}</dd></div>
          <div><dt>ครอกแรก</dt><dd>{site.firstLitter}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- What every puppy gets -->
  <section class="wrap stack gets" style="--gap:32px">
    <h2 class="section-title">{p.getsTitle}</h2>
    <ul class="gets-list">
      {
        p.gets.map((item) => (
          <li>
            <Icon name="checkCircle" size={26} />
            <span set:html={rich(item.text)} />
          </li>
        ))
      }
    </ul>
    <a href="/puppies/program/" class="text-link">ดูรายละเอียดโปรแกรมเตรียมความพร้อม →</a>
  </section>

  <!-- Waitlist: sign up by LINE -->
  <section id="waitlist" class="band-white">
    <div class="wrap stack waitlist" style="--wrap:760px;--gap:28px">
      <div class="stack" style="--gap:10px">
        <span class="eyebrow">WAITLIST</span>
        <h2 class="section-title">{p.waitlistTitle}</h2>
        <p class="waitlist-note" set:html={rich(p.waitlistNote)} />
      </div>
      <div class="ask stack" style="--gap:14px">
        <strong class="head-font">{p.waitlistAskTitle}</strong>
        <ul class="ask-list">
          {
            p.waitlistAsk.map((item) => (
              <li>
                <Icon name="check" size={20} />
                <span set:html={rich(item.text)} />
              </li>
            ))
          }
        </ul>
        <a href={site.contact.lineUrl} class="btn btn--line ask-action">
          <Icon name="chat" size={22} />
          {p.waitlistAction}
        </a>
        <span class="ask-id">LINE: {site.contact.line}</span>
      </div>
    </div>
  </section>

  <!-- Partner link -->
  <section class="wrap partner">
    <CtaBanner
      href="/puppies/partners/"
      title={p.bannerTitle}
      text={p.bannerText}
      action="ดูลูกเชลตี้พันธมิตร"
      actionTone="dark"
      size="lg"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 56px;
  }
  .status {
    background: var(--surface);
    border-radius: 24px;
    padding: 28px;
  }
  .status-who {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .status-who :global(.status-photo) {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-who strong {
    font-size: 19px;
  }
  .status-who span {
    font-size: 15px;
    color: var(--muted);
  }
  .status-facts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    font-size: 15px;
  }
  .status-facts div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .status-facts dt {
    color: var(--muted);
  }
  .status-facts dd {
    font-weight: 500;
  }

  .gets {
    padding-block: 72px;
  }
  .gets-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }
  .gets-list li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 22px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.65;
  }
  .gets-list :global(svg) {
    color: var(--brown);
  }

  .waitlist {
    padding-block: 72px;
  }
  .waitlist-note {
    font-size: 16px;
    line-height: 1.75;
    color: var(--muted);
  }
  .ask {
    background: var(--sand);
    border-radius: 20px;
    padding: 28px;
    align-items: flex-start;
  }
  .ask strong {
    font-size: 20px;
  }
  .ask-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    line-height: 1.6;
  }
  .ask-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .ask-list :global(svg) {
    color: var(--brown);
    margin-top: 3px;
  }
  .ask-action {
    font-weight: 700;
    margin-top: 6px;
  }
  .ask-id {
    font-size: 15px;
    color: var(--muted);
  }

  .partner {
    padding-block: 56px 72px;
  }
</style>
