---
import Photo from '../../components/Photo.astro';
import content from '../../content/pages/health.json';
import { page, paragraphs, photo, rich } from '../../data/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';

const p = page(content);
---

<BaseLayout
  title={p.title}
  current="sheltie"
  description={p.lead}
>
  <!-- Hero -->
  <section class="wrap split hero">
    <div class="stack">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">หน้าแรก</a> / <a href="/sheltie/">รู้จักเชลตี้</a> / สุขภาพเชลตี้
      </nav>
      <h1 class="page-title">{p.title}</h1>
      <p class="lead" set:html={rich(p.lead)} />
    </div>
    <Photo
      {...photo(p.heroImage)}
      illustration
      ratio="4 / 3"
      radius={28}
      loading="eager"
    />
  </section>

  <!-- Accordion: one item open at a time -->
  <section class="wrap stack conditions" style="--wrap:860px;--gap:20px">
    <h2>{p.conditionsTitle}</h2>
    <div class="stack" style="--gap:12px" data-accordion>
      {
        p.conditions.map((condition, i) => (
          <div class="item">
            <h3>
              <button
                type="button"
                id={`condition-${i}`}
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`condition-${i}-body`}
              >
                <span class="item-title">
                  <span class="item-num">{i + 1}</span>
                  {condition.title}
                </span>
                <span class="item-mark" aria-hidden="true">
                  +
                </span>
              </button>
            </h3>
            <p
              id={`condition-${i}-body`}
              role="region"
              aria-labelledby={`condition-${i}`}
              hidden={i !== 0}
              set:html={rich(condition.body)}
            />
          </div>
        ))
      }
    </div>
  </section>

  <!-- What we do -->
  <section class="wrap" style="--wrap:860px">
    <div class="ours stack" style="--gap:12px">
      <h2>{p.oursTitle}</h2>
      {
        paragraphs(p.oursBody).map((text) => (
          <p class:list={{ todo: text.startsWith('[') }} set:html={rich(text)} />
        ))
      }
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="wrap disclaimer" style="--wrap:860px">
    <p role="note" set:html={rich(p.disclaimer)} />
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((accordion) => {
    const buttons = accordion.querySelectorAll<HTMLButtonElement>('button[aria-controls]');
    const setOpen = (button: HTMLButtonElement, open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !open;
    };
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const wasOpen = button.getAttribute('aria-expanded') === 'true';
        buttons.forEach((b) => setOpen(b, false));
        setOpen(button, !wasOpen);
      });
    });
  });
</script>

<style>
  .hero {
    padding-block: 48px 40px;
  }

  .conditions {
    padding-block: 24px 56px;
  }
  .conditions h2 {
    font-size: clamp(26px, 3.2vw, 34px);
  }
  .item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .item h3 {
    font-size: 18px;
  }
  .item button {
    width: 100%;
    min-height: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: transparent;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 18px;
    color: var(--ink);
    text-align: left;
  }
  .item-title {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .item-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--sand);
    color: var(--brown);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
  }
  .item-mark {
    font-size: 26px;
    line-height: 1;
    color: var(--amber);
    transition: transform 0.2s;
  }
  .item button[aria-expanded='true'] .item-mark {
    transform: rotate(45deg);
  }
  .item p {
    padding: 0 20px 20px 66px;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .ours {
    background: var(--sand);
    border-radius: 24px;
    padding: 28px;
    margin-bottom: 48px;
  }
  .ours h2 {
    font-size: 24px;
  }
  .ours p {
    font-size: 16px;
    line-height: 1.8;
  }

  .disclaimer {
    padding-bottom: 72px;
  }
  .disclaimer p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .item-mark {
      transition: none;
    }
  }
</style>
