---
import CtaBanner from '../../components/CtaBanner.astro';
import Photo from '../../components/Photo.astro';
import content from '../../content/pages/colors.json';
import { page, paragraphs, photo, rich } from '../../data/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';

const p = page(content);

// Coat colour dots, matched to the main colours by position.
const swatches = [
  'background:#B9874D;box-shadow:inset -6px 0 0 #FFFFFF',
  'background:linear-gradient(90deg,#1F1F1F 60%,#A86A2E 60%)',
  'background:#1F1F1F;box-shadow:inset -6px 0 0 #FFFFFF',
];
---

<BaseLayout
  title={p.title}
  current="sheltie"
  description={`สีของเชลตี้: ${[...p.colors, ...p.others].map((color) => color.name).join(' ')}`}
>
  <!-- Page hero -->
  <section class="wrap stack hero">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">หน้าแรก</a> / <a href="/sheltie/">รู้จักเชลตี้</a> / สีเชลตี้
    </nav>
    <h1 class="page-title">{p.title}</h1>
    <p class="lead" style="max-width:720px" set:html={rich(p.lead)} />
    <p class="hero-note">{p.note}</p>
  </section>

  <!-- Main colours -->
  <section class="wrap main">
    <div class="color-grid">
      {
        p.colors.map((color, i) => (
          <article class="card color">
            <Photo
              {...photo(color.image)}
              illustration
              ratio="4 / 3"
              style="--badge-inset:12px"
              sizes="(max-width: 700px) 100vw, 400px"
            />
            <div class="color-body stack" style="--gap:10px">
              <div class="color-name">
                {swatches[i] && <span class="swatch" style={swatches[i]} aria-hidden="true" />}
                <h2>{color.name}</h2>
                <span>{color.english}</span>
              </div>
              <p set:html={rich(color.text)} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Puppy colours -->
  <section class="band-sand">
    <div class="wrap pups">
      <div class="stack" style="--gap:14px">
        <span class="eyebrow">ตอนเป็นลูกสุนัข</span>
        <h2 class="section-title" style="line-height:1.3">{p.pupsTitle}</h2>
        {paragraphs(p.pupsBody).map((text) => <p class="pups-text" set:html={rich(text)} />)}
      </div>
      <div class="pups-photos">
        {
          p.pupColors.map((pup) => (
            <figure class="stack" style="--gap:10px">
              <Photo
                {...photo(pup.image)}
                ratio="3 / 4"
                radius={20}
                widths={[480]}
                sizes="(max-width: 700px) 33vw, 200px"
              />
              <figcaption>{pup.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Other colours -->
  <section class="wrap stack others" style="--gap:24px">
    <h2>{p.othersTitle}</h2>
    <div class="other-grid">
      {
        p.others.map((color) => (
          <article class="card other">
            <Photo
              class="other-photo"
              {...photo(color.image)}
              compact
              widths={[200]}
              sizes="96px"
            />
            <div class="stack" style="--gap:6px">
              <h3>
                {color.name} {color.english && <span>{color.english}</span>}
              </h3>
              <p set:html={rich(color.text)} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap cta">
    <CtaBanner
      href="/puppies/"
      title={p.bannerTitle}
      text={p.bannerText}
      action="ลงชื่อรอครอกแรก"
    />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 56px 32px;
  }
  .hero-note {
    font-size: 14px;
    color: var(--muted);
  }

  .main {
    padding-block: 16px 64px;
  }
  .color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .color {
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .color-body {
    padding: 24px;
  }
  .color-name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--muted);
  }
  .color-name h2 {
    font-size: 26px;
    color: var(--ink);
  }
  .swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--line);
  }
  .color-body p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .pups {
    padding-block: 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    align-items: center;
  }
  .pups-text {
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-soft);
  }
  .pups-photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  figcaption {
    font-size: 15px;
    font-weight: 600;
  }

  .others {
    padding-block: 64px;
  }
  .others h2 {
    font-size: 28px;
  }
  .other-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .other {
    border-radius: 20px;
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .other :global(.other-photo) {
    width: 96px;
    height: 96px;
    border-radius: 16px;
    flex-shrink: 0;
  }
  .other h3 {
    font-size: 20px;
  }
  .other h3 span {
    font-size: 14px;
    color: var(--muted);
    font-weight: 400;
  }
  .other p {
    font-size: 15px;
    color: var(--muted);
  }

  .cta {
    padding-bottom: 72px;
  }
</style>
