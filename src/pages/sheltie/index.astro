---
import Photo from '../../components/Photo.astro';
import content from '../../content/pages/sheltie.json';
import { page, paragraphs, photo, rich } from '../../data/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';

const p = page(content);

const more = [
  { href: '/sheltie/health/', title: 'สุขภาพเชลตี้', text: 'โรคทางพันธุกรรมที่ควรรู้' },
  { href: '/sheltie/colors/', title: 'สีเชลตี้', text: 'เซเบิล ไตรคัลเลอร์ ไบแบล็ก และสีอื่นๆ' },
];
---

<BaseLayout
  title={`${p.title} (Shetland Sheepdog)`}
  current="sheltie"
  description={`${p.title} (Shetland Sheepdog): ${p.lead}`}
>
  <!-- Hero -->
  <section class="wrap split hero">
    <div class="stack">
      <nav class="breadcrumb" aria-label="breadcrumb"><a href="/">หน้าแรก</a> / รู้จักเชลตี้</nav>
      <h1 class="page-title">{p.title}<br /><span>Shetland Sheepdog</span></h1>
      <p class="lead" set:html={rich(p.lead)} />
    </div>
    <Photo
      {...photo(p.heroImage)}
      illustration
      ratio="4 / 3"
      radius={28}
      loading="eager"
    />
  </section>

  <!-- Origin + quick facts -->
  <section class="wrap origin">
    <div class="origin-text stack">
      <h2 class="section-title">{p.originTitle}</h2>
      {paragraphs(p.originBody).map((text) => <p class="body-text" set:html={rich(text)} />)}
    </div>
    <aside class="facts stack" aria-label="ข้อมูลโดยย่อ">
      <h2>{p.factsTitle}</h2>
      <dl>
        {
          p.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <a href="/sheltie/colors/" class="text-link" style="font-size:15px">ดูสีเชลตี้ทั้งหมด →</a>
    </aside>
  </section>

  <!-- Built for -->
  <section class="band-white">
    <div class="wrap stack block" style="--gap:28px">
      <div class="stack intro" style="--gap:14px">
        <h2 class="section-title">{p.builtTitle}</h2>
        {paragraphs(p.builtBody).map((text) => <p class="body-text" set:html={rich(text)} />)}
      </div>
      <div class="jobs">
        {
          p.jobs.map((job) => (
            <figure class="stack" style="--gap:10px">
              <Photo {...photo(job.image)} ratio="16 / 10" radius={22} />
              <figcaption>{job.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Temperament -->
  <section class="wrap stack block" style="--gap:28px">
    <div class="stack intro" style="--gap:14px">
      <h2 class="section-title">{p.temperTitle}</h2>
      {paragraphs(p.temperBody).map((text) => <p class="body-text" set:html={rich(text)} />)}
    </div>
    <h3 class="know-title">{p.knowTitle}</h3>
    <div class="know-grid">
      {
        p.know.map((item) => (
          <article class="card know">
            <strong class="head-font">{item.title}</strong>
            <p set:html={rich(item.text)} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- Who it suits -->
  <section class="band-sand">
    <div class="wrap split block">
      <div class="stack" style="--gap:14px">
        <h2 class="section-title">{p.suitsTitle}</h2>
        {paragraphs(p.suitsBody).map((text) => <p class="body-text" set:html={rich(text)} />)}
        <a href="/puppies/" class="btn btn--md" style="align-self:flex-start;margin-top:6px"
          >ลงชื่อรอครอกแรก</a
        >
      </div>
      <div class="suits-photos">
        <Photo
          {...photo(p.suitsImage1)}
          ratio="1 / 1"
          radius={20}
          sizes="(max-width: 700px) 50vw, 300px"
        />
        <Photo
          {...photo(p.suitsImage2)}
          ratio="1 / 1"
          radius={20}
          sizes="(max-width: 700px) 50vw, 300px"
          style="margin-top:32px"
        />
      </div>
    </div>
  </section>

  <!-- More -->
  <section class="wrap more">
    {
      more.map((link) => (
        <a href={link.href} class="card more-link">
          <span class="stack" style="--gap:4px">
            <strong class="head-font">{link.title}</strong>
            <span>{link.text}</span>
          </span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .block {
    padding-block: 64px;
  }
  .hero {
    padding-block: 48px 40px;
  }
  h1 span {
    color: var(--brown);
    font-size: 0.6em;
  }

  .origin {
    padding-block: 32px 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
  }
  .origin-text {
    flex: 999 1 520px;
    min-width: 0;
  }
  .facts {
    flex: 1 1 300px;
    background: var(--sand);
    border-radius: 24px;
    padding: 28px;
  }
  .facts h2 {
    font-size: 20px;
  }
  .facts dl {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
  }
  .facts dl div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .facts dl div:not(:last-child) {
    border-bottom: 1px solid #e0d5c8;
    padding-bottom: 12px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    font-weight: 600;
    text-align: right;
  }

  .intro {
    max-width: 760px;
  }
  .jobs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  figcaption {
    font-size: 15px;
    color: var(--muted);
  }

  .know-title {
    font-size: 20px;
  }
  .know-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .know {
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .know strong {
    font-size: 18px;
  }
  .know p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .suits-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .more {
    padding-block: 56px 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .more-link {
    text-decoration: none;
    color: var(--ink);
    padding: 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .more-link strong {
    font-size: 20px;
  }
  .more-link .stack span {
    font-size: 15px;
    color: var(--muted);
  }
  .arrow {
    color: var(--amber);
    font-size: 22px;
  }
</style>
