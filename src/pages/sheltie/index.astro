---
import Photo from '../../components/Photo.astro';
import { images } from '../../data/images';
import BaseLayout from '../../layouts/BaseLayout.astro';

const facts = [
  { label: 'ความสูง', value: '13-16 นิ้ว (33-41 ซม.)' },
  { label: 'น้ำหนัก', value: '7-11 กก.' },
  { label: 'อายุขัยเฉลี่ย', value: '12-14 ปี' },
  { label: 'ขน', value: 'ขนสองชั้นหนาแน่น มีแผงขนรอบคอ หางเป็นพู่' },
  { label: 'สีมาตรฐาน AKC', value: 'ดำ บลูเมิร์ล เซเบิล (มักมีสีขาวหรือน้ำตาลแต้ม)' },
];

const goodToKnow = [
  {
    title: 'ระวังคนแปลกหน้า',
    text: 'เป็นธรรมชาติของสุนัขต้อนสัตว์ ควรพาเข้าสังคมตั้งแต่เล็ก',
  },
  { title: 'ชอบเห่า', text: 'ควรฝึกตั้งแต่เด็ก' },
  { title: 'ต้องการกิจกรรม', text: 'ต้องได้ออกกำลังกายและเล่นเกมใช้สมองทุกวัน' },
];

const more = [
  { href: '/sheltie/health/', title: 'สุขภาพเชลตี้', text: 'โรคทางพันธุกรรมที่ควรรู้' },
  { href: '/sheltie/colors/', title: 'สีเชลตี้', text: 'เซเบิล ไตรคัลเลอร์ ไบแบล็ก และสีอื่นๆ' },
];
---

<BaseLayout
  title="รู้จักเชลตี้ (Shetland Sheepdog)"
  current="sheltie"
  description="รู้จักเชลตี้ (Shetland Sheepdog): ต้นกำเนิด นิสัย ขนาด และเชลตี้เหมาะกับครอบครัวแบบไหน"
>
  <!-- Hero -->
  <section class="wrap split hero">
    <div class="stack">
      <nav class="breadcrumb" aria-label="breadcrumb"><a href="/">หน้าแรก</a> / รู้จักเชลตี้</nav>
      <h1 class="page-title">รู้จักเชลตี้<br /><span>Shetland Sheepdog</span></h1>
      <p class="lead">ต้นกำเนิด นิสัย ขนาด และเชลตี้เหมาะกับครอบครัวแบบไหน</p>
    </div>
    <Photo
      src={images.biblackAdultAutumn}
      alt="เชลตี้สีไบแบล็กยืนบนสนามหญ้ายามเย็น (ภาพประกอบ)"
      illustration
      ratio="4 / 3"
      radius={28}
      loading="eager"
    />
  </section>

  <!-- Origin + quick facts -->
  <section class="wrap origin">
    <div class="origin-text stack">
      <h2 class="section-title">ต้นกำเนิด</h2>
      <p class="body-text">
        เชลตี้มาจากหมู่เกาะเช็ตแลนด์ ประเทศสกอตแลนด์ ในช่วงศตวรรษที่ 1800
        เป็นหมู่เกาะทางเหนือสุดของสหราชอาณาจักรที่อากาศหนาวและลมแรง เชลตี้เป็นสายพันธุ์ตัวเล็กแต่ทนทาน
        เช่นเดียวกับม้าแคระเช็ตแลนด์และแกะเช็ตแลนด์ ที่ถูกพัฒนาให้อยู่รอดในสภาพแห้งแล้งของเกาะบ้านเกิด
      </p>
      <p class="body-text">
        แม้หน้าตาคล้ายคอลลี่ย่อส่วน แต่เชลตี้เป็นสายพันธุ์แยกต่างหาก ช่วงต้นศตวรรษที่ 20 James Loggie
        นำรัฟคอลลี่ตัวเล็กเข้ามาผสมในสายเลือด ช่วยวางรากฐานให้เกิดเชลตี้แบบปัจจุบัน Kennel Club
        ของอังกฤษรับรองสายพันธุ์ในปี 1909 ภายใต้ชื่อ Shetland Collie
        ก่อนเปลี่ยนชื่อเพราะผู้เลี้ยงคอลลี่คัดค้าน และ AKC ของอเมริกาจดทะเบียนในชื่อ Shetland Sheepdog
        ในปี 1911
      </p>
    </div>
    <aside class="facts stack" aria-label="ข้อมูลโดยย่อ">
      <h2>ข้อมูลโดยย่อ</h2>
      <dl>
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <a href="/sheltie/colors/" class="text-link" style="font-size:15px">ดูสีเชลตี้ทั้งหมด →</a>
    </aside>
  </section>

  <!-- Built for -->
  <section class="band-white">
    <div class="wrap stack block" style="--gap:28px">
      <div class="stack intro" style="--gap:14px">
        <h2 class="section-title">ถูกสร้างมาเพื่ออะไร</h2>
        <p class="body-text">
          เชลตี้เป็นสุนัขทำงานในฟาร์ม ใช้ต้อนแกะ สัตว์ปีก และม้าแคระ จึงอยู่ในกลุ่มสุนัขต้อนสัตว์
          (Herding) สัญชาตญาณนี้ยังติดตัวมาถึงทุกวันนี้ ทำให้เชลตี้เก่งกีฬาสุนัข ทั้งการต้อนสัตว์
          อจิลิตี้ การฝึกเชื่อฟัง แรลลี่ และการตามกลิ่น
        </p>
      </div>
      <div class="jobs">
        <figure class="stack" style="--gap:10px">
          <Photo
            src={images.herdingSable}
            alt="เชลตี้สีเซเบิลกำลังต้อนแกะในทุ่งหญ้า (ภาพประกอบ)"
            ratio="16 / 10"
            radius={22}
            position="60% 50%"
          />
          <figcaption>การต้อนสัตว์</figcaption>
        </figure>
        <figure class="stack" style="--gap:10px">
          <Photo
            src={images.agilityTri}
            alt="เชลตี้สีไตรคัลเลอร์กระโดดข้ามรั้วอจิลิตี้ (ภาพประกอบ)"
            ratio="16 / 10"
            radius={22}
            position="50% 50%"
          />
          <figcaption>อจิลิตี้</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Temperament -->
  <section class="wrap stack block" style="--gap:28px">
    <div class="stack intro" style="--gap:14px">
      <h2 class="section-title">นิสัย</h2>
      <p class="body-text">
        ซื่อสัตย์ อ่อนโยน ฉลาด เข้าใจคนได้ดี ขี้เล่นและชอบเอาใจเจ้าของ เป็นสุนัขในบ้านที่ดีมาก
      </p>
    </div>
    <h3 class="know-title">สิ่งที่ว่าที่เจ้าของควรรู้</h3>
    <div class="know-grid">
      {
        goodToKnow.map((item) => (
          <article class="card know">
            <strong class="head-font">{item.title}</strong>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Who it suits -->
  <section class="band-sand">
    <div class="wrap split block">
      <div class="stack" style="--gap:14px">
        <h2 class="section-title">เหมาะกับใคร</h2>
        <p class="body-text">
          ครอบครัวที่มีเวลาให้ ชอบทำกิจกรรมกับสุนัข และพร้อมดูแลขนสม่ำเสมอ เชลตี้ตัวไม่ใหญ่
          เลี้ยงในบ้านได้ดี แต่ไม่เหมาะกับบ้านที่ปล่อยสุนัขอยู่ลำพังทั้งวัน
        </p>
        <a href="/puppies/" class="btn btn--md" style="align-self:flex-start;margin-top:6px"
          >ลงชื่อรอครอกแรก</a
        >
      </div>
      <div class="suits-photos">
        <Photo
          src={images.homeBiblack}
          alt="เชลตี้สีไบแบล็กนอนพักในห้องนั่งเล่น มีคนลูบหัว (ภาพประกอบ)"
          ratio="1 / 1"
          radius={20}
          position="55% 60%"
          sizes="(max-width: 700px) 50vw, 300px"
        />
        <Photo
          src={images.groomSable}
          alt="หวีขนแผงคอของเชลตี้สีเซเบิล (ภาพประกอบ)"
          ratio="1 / 1"
          radius={20}
          position="55% 50%"
          sizes="(max-width: 700px) 50vw, 300px"
          style="margin-top:32px"
        />
      </div>
    </div>
  </section>

  <!-- More -->
  <section class="wrap more">
    {
      more.map((link) => (
        <a href={link.href} class="card more-link">
          <span class="stack" style="--gap:4px">
            <strong class="head-font">{link.title}</strong>
            <span>{link.text}</span>
          </span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .block {
    padding-block: 64px;
  }
  .hero {
    padding-block: 48px 40px;
  }
  h1 span {
    color: var(--brown);
    font-size: 0.6em;
  }

  .origin {
    padding-block: 32px 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
  }
  .origin-text {
    flex: 999 1 520px;
    min-width: 0;
  }
  .facts {
    flex: 1 1 300px;
    background: var(--sand);
    border-radius: 24px;
    padding: 28px;
  }
  .facts h2 {
    font-size: 20px;
  }
  .facts dl {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
  }
  .facts dl div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .facts dl div:not(:last-child) {
    border-bottom: 1px solid #e0d5c8;
    padding-bottom: 12px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    font-weight: 600;
    text-align: right;
  }

  .intro {
    max-width: 760px;
  }
  .jobs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  figcaption {
    font-size: 15px;
    color: var(--muted);
  }

  .know-title {
    font-size: 20px;
  }
  .know-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .know {
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .know strong {
    font-size: 18px;
  }
  .know p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .suits-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .more {
    padding-block: 56px 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .more-link {
    text-decoration: none;
    color: var(--ink);
    padding: 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .more-link strong {
    font-size: 20px;
  }
  .more-link .stack span {
    font-size: 15px;
    color: var(--muted);
  }
  .arrow {
    color: var(--amber);
    font-size: 22px;
  }
</style>
