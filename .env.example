# Show the temporary AI photos in slots that are waiting for real photos
# (Helga, parents, partner puppies, journal). Defaults to on in `astro dev`
# and off in `astro build`, so they never ship by accident.
PUBLIC_SHOW_TEMP_PHOTOS=false

# URL that the waitlist / contact forms POST to (multipart form data).
# While empty the forms only show the thank-you state and send nothing.
PUBLIC_FORM_ENDPOINT=
