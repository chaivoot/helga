# --- Back office (/admin) ---
# Password for logging in to /admin. Required.
ADMIN_PASSWORD=

# GitHub token used to save edits as commits (fine-grained token with
# "Contents: Read and write" on this repository). Required in production.
# Without it, `astro dev` edits the files on local disk instead.
GITHUB_TOKEN=

# Repository and branch to commit to. On Vercel these are detected
# automatically; set them only when hosting elsewhere.
# GITHUB_REPO=owner/name
# GITHUB_BRANCH=main

# --- Public site ---
# Temporary AI photos fill the slots that are waiting for real photos
# (Helga, parents, partner puppies, journal). Set to false to show a striped
# "waiting for photo" slot there instead.
PUBLIC_SHOW_TEMP_PHOTOS=true
